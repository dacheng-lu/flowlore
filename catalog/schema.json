{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dacheng-lu/flowlore/catalog/schema.json",
  "title": "FlowLore catalog",
  "description": "Machine-readable index of sources, skills, documents, learning paths and recipes. Version 0.2, 2026-11-03.",
  "type": "object",
  "required": ["catalogVersion", "reviewed", "entries"],
  "additionalProperties": false,
  "properties": {
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "Minor bump when entries or statuses change, major bump when this schema breaks."
    },
    "reviewed": {
      "type": "string",
      "format": "date",
      "description": "Date on which the catalog as a whole was last reviewed."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "entry": {
      "type": "object",
      "required": ["id", "type", "title", "summary", "status", "tags"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "type": {
          "type": "string",
          "enum": ["source", "skill", "recipe", "doc", "learning-path"]
        },
        "title": { "type": "string", "minLength": 3 },
        "summary": { "type": "string", "minLength": 20 },
        "status": {
          "type": "string",
          "enum": ["draft", "field-tested", "verified"]
        },
        "verifiedOn": {
          "type": "string",
          "format": "date",
          "description": "Date of the evidence named in `evidence`."
        },
        "evidence": {
          "type": "string",
          "minLength": 10,
          "description": "What was checked, where, on which version. A summary, not a full log."
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "description": "External location. Exactly one of url/path is allowed."
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "description": "Repository-relative path. Exactly one of url/path is allowed."
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" },
          "description": "Ids of entries this one is based on. Must resolve to type source, skill or doc."
        },
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "lessons": { "type": "integer", "minimum": 1 },
        "input": { "type": "string", "minLength": 3 },
        "output": { "type": "string", "minLength": 3 },
        "reviewedBlob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Git blob hash of the upstream file that was reviewed, for skills."
        }
      },
      "anyOf": [
        { "required": ["url"] },
        { "required": ["path"] }
      ]
    }
  }
}
